APP_NAME="Laksamana API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=core
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=lakk5493_laksamana_core
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=array
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Laksamana legacy databases (hybrid phase) ---------------------------
# Label reported by legacy ping/stats: produksi | dev | lokal
LAKSAMANA_ENV_LABEL=lokal
# Shared credentials for all legacy DBs; override per DB with
# DB_<ENV>_DATABASE / DB_<ENV>_USERNAME / DB_<ENV>_PASSWORD, where <ENV> is one of
# ACCOUNT ABSENSI AKADEMI BD DW EMS FINANCE HLIFE HR JADWAL KOMPAS KONTEN MARKETING RESERVASI STOCK
# Dev server example: DB_ACCOUNT_DATABASE=lakk5493_db_dev_account
DB_LEGACY_USERNAME=root
DB_LEGACY_PASSWORD=
# Per-Modul cutover: set DB_<KEY>_CONNECTION=core and <KEY>_MAINTENANCE=true
# only while rehearsing that Modul. Example: DB_MARKETING_CONNECTION=core
# MARKETING_MAINTENANCE=true. Defaults keep every Modul on its legacy database
# and writable.
# Optional old shared API_TOKEN (legacy routes only). Empty = open.
LEGACY_API_TOKEN=
# --- Reservasi recap automation (GET /api/v1/reservasi/recap) ---------------
# Pin the recap at the PROD reservasi DB even when the app runs against dev:
# ?source=prod then reads prod instead of the module connection. Create the
# user in MySQL with SELECT-only rights, e.g.:
#   CREATE USER 'recap_ro'@'%' IDENTIFIED BY '<strong password>';
#   GRANT SELECT ON lakk5493_db_reservasi.* TO 'recap_ro'@'%';
# Leave unset (default) and ?source=prod answers 501; the normal ?source=
# (default) keeps using the reservasi module connection. dev-api needs this
# pin; the prod deploy does NOT (its module connection already is prod).
#RESERVASI_RECAP_PROD_HOST=127.0.0.1
#RESERVASI_RECAP_PROD_PORT=3306
#RESERVASI_RECAP_PROD_DATABASE=lakk5493_db_reservasi
#RESERVASI_RECAP_PROD_USERNAME=recap_ro
#RESERVASI_RECAP_PROD_PASSWORD=
# --- Morning briefing automation (GET /api/v1/info/pagi) ------------------
# Same pattern: pin the briefing at the PROD event (EMS) + marketing DBs even
# when the app runs against dev. REUSE the recap SELECT-only user — just
# extend it (cPanel > MySQL Databases, no CREATE USER privilege there):
#   GRANT SELECT ON lakk5493_db_ems.* TO 'recap_ro'@'%';
#   GRANT SELECT ON lakk5493_db_marketing.* TO 'recap_ro'@'%';
# Leave unset (default) and ?source=prod answers 501.
#EVENT_INFO_PROD_HOST=127.0.0.1
#EVENT_INFO_PROD_PORT=3306
#EVENT_INFO_PROD_DATABASE=lakk5493_db_ems
#EVENT_INFO_PROD_USERNAME=recap_ro
#EVENT_INFO_PROD_PASSWORD=
#MARKETING_INFO_PROD_HOST=127.0.0.1
#MARKETING_INFO_PROD_PORT=3306
#MARKETING_INFO_PROD_DATABASE=lakk5493_db_marketing
#MARKETING_INFO_PROD_USERNAME=recap_ro
#MARKETING_INFO_PROD_PASSWORD=

# --- Automation feeds (GET /api/v1/automation/*, #234) ---------------------
# One read-only connection for every n8n feed, instead of one *_PROD_* set per
# endpoint. Empty AUTOMATION_DB_HOST = not pinned: the feeds fall back to the
# normal module connections (local & tests). Fill it on dev-api with the PROD
# DBs and the SELECT-only user, so n8n keeps reading prod while the app runs
# on dev; the database name per module comes from config/laksamana.php.
# On api.laksamanamuda.id leave it empty (the module connections are prod).
# GRANT SELECT per table (never db.*), see docs/api/automation.md:
#   GRANT SELECT ON lakk5493_db_reservasi.reservations TO 'recap_ro'@'%';
#   GRANT SELECT ON lakk5493_db_ems.events               TO 'recap_ro'@'%';
#   GRANT SELECT ON lakk5493_db_marketing.events         TO 'recap_ro'@'%';
#   GRANT SELECT ON lakk5493_db_marketing.settings       TO 'recap_ro'@'%';
#AUTOMATION_DB_HOST=127.0.0.1
#AUTOMATION_DB_PORT=3306
#AUTOMATION_DB_USERNAME=recap_ro
#AUTOMATION_DB_PASSWORD=
