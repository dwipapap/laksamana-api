{
  "dir": "hr-mysql",
  "legacyPath": "hr-api-mysql",
  "dbEnv": "HR",
  "db": "lakk5493_db_hr",
  "setupSql": [
    "CREATE TABLE IF NOT EXISTS attendance_months (bulan VARCHAR(10) NOT NULL, data LONGTEXT NOT NULL, imported_at VARCHAR(40) NOT NULL DEFAULT '', imported_by VARCHAR(120) NOT NULL DEFAULT '', PRIMARY KEY (bulan)) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci",
    "CREATE TABLE IF NOT EXISTS attendance_days (bulan VARCHAR(10) NOT NULL, talenta_id VARCHAR(32) NOT NULL, tanggal VARCHAR(10) NOT NULL, emp_id VARCHAR(64) NOT NULL DEFAULT '', data LONGTEXT NOT NULL, PRIMARY KEY (bulan, talenta_id, tanggal), KEY idx_att_emp (emp_id, bulan), KEY idx_att_bulan (bulan)) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci"
  ],
  "ignore": ["data.time", "data.db", "data._savedAt", "savedAt"],
  "cases": [
    {"name": "ping", "method": "GET", "query": {"action": "ping"}},
    {"name": "stats", "method": "GET", "query": {"action": "stats"}},
    {"name": "getAll", "method": "GET", "query": {"action": "getAll"}},
    {"name": "GET without action", "method": "GET", "query": {}},
    {"name": "GET unknown action", "method": "GET", "query": {"action": "saveAll"}},
    {"name": "POST body not an object", "body": "x"},
    {"name": "POST unknown action", "body": {"action": "getAll"}},
    {"name": "saveAll without data", "body": {"action": "saveAll", "baseRev": 129}},
    {"name": "saveAll employees not a list", "body": {"action": "saveAll", "baseRev": 129, "data": {"employees": {}}}},
    {"name": "saveAll action from the query string", "query": {"action": "saveAll"}, "body": {"baseRev": 129}},
    {"name": "saveAll stale rev -> conflict", "body": {"action": "saveAll", "baseRev": 5, "by": "X", "data": {"employees": []}}},
    {"name": "saveAll without baseRev on a used document -> conflict", "body": {"action": "saveAll", "by": "X", "data": {"employees": []}}},
    {"name": "getAll unchanged after refusals", "method": "GET", "query": {"action": "getAll"}},

