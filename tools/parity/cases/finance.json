{
  "dir": "finance-mysql",
  "legacyPath": "finance-api-mysql",
  "dbEnv": "FINANCE",
  "db": "lakk5493_db_finance",
  "ignore": ["data.env", "data.trx.*.dibuat_at"],
  "cases": [
    {"name": "ping", "method": "GET", "query": {"action": "ping"}},
    {"name": "stats", "method": "GET", "query": {"action": "stats"}},
    {"name": "getAll", "method": "GET", "query": {"action": "getAll"}},
    {"name": "getAll is the default (GET)", "method": "GET", "query": {}},
    {"name": "getAll is the default (POST without action)", "body": {}},
    {"name": "query action wins over body action", "query": {"action": "stats"}, "body": {"action": "getAll"}},
    {"name": "unknown action", "query": {"action": "nope"}, "body": {}},

    {"name": "simpanTrx bad date", "query": {"action": "simpanTrx"}, "body": {"tgl": "2026-9-1", "keterangan": "x"}},
    {"name": "simpanTrx no description", "query": {"action": "simpanTrx"}, "body": {"tgl": "2026-09-01", "keterangan": "  "}},
    {"name": "simpanTrx no amounts", "query": {"action": "simpanTrx"}, "body": {"tgl": "2026-09-01", "keterangan": "x", "baris": [{"pos_id": 1, "debet": 0, "kredit": 0}, {"pos_id": 0, "debet": 5}]}},
    {"name": "simpanTrx negative", "query": {"action": "simpanTrx"}, "body": {"tgl": "2026-09-01", "keterangan": "x", "baris": [{"pos_id": 1, "debet": -5}]}},
    {"name": "simpanTrx debit and credit on one row", "query": {"action": "simpanTrx"}, "body": {"tgl": "2026-09-01", "keterangan": "x", "baris": [{"pos_id": 1, "debet": 5, "kredit": 5}]}},
    {"name": "simpanTrx same source twice", "query": {"action": "simpanTrx"}, "body": {"tgl": "2026-09-01", "keterangan": "x", "baris": [{"pos_id": 1, "debet": 5}, {"pos_id": 1, "kredit": 3}]}},
    {"name": "simpanTrx edit of a missing trx", "query": {"action": "simpanTrx"}, "body": {"id": 999, "tgl": "2026-09-01", "keterangan": "x", "baris": [{"pos_id": 1, "debet": 5}]}},
    {"name": "simpanTrx create", "query": {"action": "simpanTrx"}, "body": {"tgl": "2026-09-02", "keterangan": " Beli galon ", "kategori_id": "4", "input": 1, "bon": 0, "oleh": "  Kasir Parity  ", "baris": [{"pos_id": 1, "kredit": "15000"}, {"pos_id": 2, "debet": 0, "kredit": 0}]}},
    {"name": "getAll after create", "method": "GET", "query": {"action": "getAll"}},
    {"name": "simpanTrx edit (split rewritten)", "query": {"action": "simpanTrx"}, "body": {"id": 4, "tgl": "2026-08-30", "keterangan": "Beli galon (koreksi)", "kategori_id": "", "baris": [{"pos_id": 2, "kredit": 16000}, {"pos_id": 3, "debet": 500}]}},
    {"name": "simpanTrx edit with identical values", "query": {"action": "simpanTrx"}, "body": {"id": 4, "tgl": "2026-08-30", "keterangan": "Beli galon (koreksi)", "kategori_id": null, "baris": [{"pos_id": 2, "kredit": 16000}, {"pos_id": 3, "debet": 500}]}},
    {"name": "tandai bon", "query": {"action": "tandai"}, "body": {"id": 4, "field": "bon", "nilai": 1}},
    {"name": "tandai same value again", "query": {"action": "tandai"}, "body": {"id": 4, "field": "bon", "nilai": true}},
    {"name": "tandai unknown field", "query": {"action": "tandai"}, "body": {"id": 4, "field": "tgl", "nilai": 1}},
    {"name": "tandai without id", "query": {"action": "tandai"}, "body": {"field": "input"}},
    {"name": "getAll after edits", "method": "GET", "query": {"action": "getAll"}},

    {"name": "simpanPos without a name", "query": {"action": "simpanPos"}, "body": {"nama": " "}},
    {"name": "simpanPos duplicate name", "query": {"action": "simpanPos"}, "body": {"nama": "Kas Kecil", "urut": 5}},
    {"name": "simpanPos create", "query": {"action": "simpanPos"}, "body": {"nama": "Pos Parity", "urut": "45"}},
    {"name": "simpanPos rename", "query": {"action": "simpanPos"}, "body": {"id": 4, "nama": "Pos Parity 2", "urut": 46}},
    {"name": "nonaktifPos", "query": {"action": "nonaktifPos"}, "body": {"id": 4}},
    {"name": "aktifPos", "query": {"action": "aktifPos"}, "body": {"id": 4}},
    {"name": "hapusPos used", "query": {"action": "hapusPos"}, "body": {"id": 1}},
    {"name": "hapusPos unused", "query": {"action": "hapusPos"}, "body": {"id": 4}},
    {"name": "simpanKategori duplicate", "query": {"action": "simpanKategori"}, "body": {"nama": "COGS"}},
    {"name": "simpanKategori create", "query": {"action": "simpanKategori"}, "body": {"nama": "Kategori Parity", "urut": 130}},
    {"name": "hapusKategori used", "query": {"action": "hapusKategori"}, "body": {"id": 4}},
    {"name": "nonaktifKategori", "query": {"action": "nonaktifKategori"}, "body": {"id": 13}},
    {"name": "hapusKategori unused", "query": {"action": "hapusKategori"}, "body": {"id": 13}},

    {"name": "hapusTrx bad id", "query": {"action": "hapusTrx"}, "body": {"id": "x"}},
    {"name": "hapusTrx", "query": {"action": "hapusTrx"}, "body": {"id": 4}},
    {"name": "hapusTrx again", "query": {"action": "hapusTrx"}, "body": {"id": 4}},

    {"name": "simpanPeran without key", "query": {"action": "simpanPeran"}, "body": {"peran": "viewer"}},
    {"name": "simpanPeran set", "query": {"action": "simpanPeran"}, "body": {"kunci": " #u-parity ", "peran": "manajemen"}},
    {"name": "simpanPeran clear", "query": {"action": "simpanPeran"}, "body": {"kunci": "#u-jb", "peran": ""}},
    {"name": "simpanAkses (clamped, junk skipped)", "query": {"action": "simpanAkses"}, "body": {"peta": {"staf": {"kk_input": 1, "rekap": 7, "invoice": -3, "": 2}, "viewer": "junk", "": {"x": 1}, "manajemen": {}}}},
    {"name": "simpanAkses without peta empties", "query": {"action": "simpanAkses"}, "body": {}},
    {"name": "brankasGet", "method": "GET", "query": {"action": "brankasGet"}},
    {"name": "brankasSave without data", "query": {"action": "brankasSave"}, "body": {"oleh": "x"}},
    {"name": "brankasSave data not a map", "query": {"action": "brankasSave"}, "body": {"data": "x"}},
    {"name": "brankasSave filters to the kept keys", "query": {"action": "brankasSave"}, "ignore": ["data.updated_at"], "body": {"oleh": "  CFO Parity  ", "data": {
      "rekening": [{"id": "r1", "bank": "BRI", "saldoAwal": 1000}],
      "piutang": {"a": {"id": "p1", "nominal": 5}},
      "bayar": "junk",
      "investor": [{"id": "i1", "nama": "Inv", "modal": 1e9}],
      "mutasi": [{"id": "m1", "tgl": "2026-09-01", "ket": "a/b ✓"}],
      "setting": {},
      "unknownKey": [1, 2, 3]
    }}},
    {"name": "brankasGet after save", "method": "GET", "query": {"action": "brankasGet"}, "ignore": ["data.updated_at"]},
    {"name": "bayarSave without bayar", "query": {"action": "bayarSave"}, "body": {"oleh": "Kasir"}},
    {"name": "bayarSave replaces only bayar", "query": {"action": "bayarSave"}, "ignore": ["data.updated_at"], "body": {"oleh": "Kasir", "bayar": {"x": {"id": "b1", "status": "paid", "nominal": 25000}}}},
    {"name": "brankasGet after bayarSave", "method": "GET", "query": {"action": "brankasGet"}, "ignore": ["data.updated_at"]},
    {"name": "brankasSave data as a list", "query": {"action": "brankasSave"}, "ignore": ["data.updated_at"], "body": {"data": [1, 2]}},
    {"name": "brankasGet after list save", "method": "GET", "query": {"action": "brankasGet"}, "ignore": ["data.updated_at"]},
    {"name": "brankasAkses", "query": {"action": "brankasAkses"}, "body": {"peta": {"cfo": {"saldo": 2, "investor": 5}, "staf": {"saldo": -1}, "x": "junk"}}},
    {"name": "brankasPeran without key", "query": {"action": "brankasPeran"}, "body": {"peran": "cfo"}},
    {"name": "brankasPeran set", "query": {"action": "brankasPeran"}, "body": {"kunci": "#u-parity", "peran": "cfo"}},
    {"name": "brankasPeran clear", "query": {"action": "brankasPeran"}, "body": {"kunci": "#u-parity", "peran": " "}},
    {"name": "getAll at the end", "method": "GET", "query": {"action": "getAll"}},
    {"name": "stats at the end", "method": "GET", "query": {"action": "stats"}}
  ]
}
