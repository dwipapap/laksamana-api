{
  "dir": "kompas-mysql",
  "legacyPath": "kompas-api-mysql",
  "dbEnv": "KOMPAS",
  "db": "lakk5493_db_kompas",
  "ignore": ["data.ts", "data.backend", "data.db", "data.waktu"],
  "sessions": {"mkt": "SELECT CONCAT(name,'|',pin) FROM users WHERE id='u-aurel'"},
  "cases": [
    {"name": "ping", "method": "GET", "query": {"action": "ping"}},
    {"name": "stats", "method": "GET", "query": {"action": "stats"}},
    {"name": "getAll", "method": "GET", "query": {"action": "getAll"}},
    {"name": "getAll is the GET default", "method": "GET", "query": {}},
    {"name": "unknown action", "body": {"action": "voidLost"}},

    {"name": "omsetPic August–September", "method": "GET", "query": {"action": "omsetPic", "dari": "2026-08-01", "sampai": "2026-09-30"}},
    {"name": "omsetPic reversed range", "method": "GET", "query": {"action": "omsetPic", "dari": "2026-09-15", "sampai": "2026-09-01"}},
    {"name": "omsetPic bad date", "method": "GET", "query": {"action": "omsetPic", "dari": "2026-9-1", "sampai": "2026-09-30"}},
    {"name": "omsetPic without a range", "method": "GET", "query": {"action": "omsetPic"}},

    {"name": "performaDivisi without a session", "body": {"action": "performaDivisi", "dari": "2026-08-01", "sampai": "2026-09-30"}},
    {"name": "performaDivisi marketing", "body": {"action": "performaDivisi", "sesi": "$sesi:mkt", "divi": "marketing", "dari": "2026-08-01", "sampai": "2026-09-30"}},
    {"name": "performaDivisi range from the query", "query": {"action": "performaDivisi", "dari": "2026-09-01", "sampai": "2026-08-20"}, "body": {"action": "performaDivisi", "sesi": "$sesi:mkt"}},
    {"name": "performaDivisi event without the Event module", "body": {"action": "performaDivisi", "sesi": "$sesi:mkt", "divi": "event", "dari": "2026-08-01", "sampai": "2026-09-30"}},
    {"name": "performaDivisi bad range", "body": {"action": "performaDivisi", "sesi": "$sesi:mkt", "dari": "x", "sampai": "2026-09-30"}},

    {"name": "saveAll without data", "body": {"action": "saveAll"}},
    {"name": "saveAll stale baseTs is refused", "body": {"action": "saveAll", "baseTs": 1, "data": {"daily": []}}},

    {"name": "simpanTarget without data", "body": {"action": "simpanTarget"}},
    {"name": "simpanTarget patches targets only", "body": {"action": "simpanTarget", "data": {
      "companyMonthlyTarget": "1.500.000.000", "useWorkingDays": 1, "workingDaysPerMonth": "0",
      "target": {"nope-id": 5}, "by": "Parity Finance"}}},
    {"name": "stats after target", "method": "GET", "query": {"action": "stats"}, "ignore": ["data.updated_at"]},

    {"name": "simpanRekap without data", "body": {"action": "simpanRekap"}},
    {"name": "simpanRekap without days", "body": {"action": "simpanRekap", "data": {"by": "x"}}},
    {"name": "simpanRekap setoran without days", "body": {"action": "simpanRekap", "data": {"hari": {}, "setoran": {"tambah": [{"tgl": "2026-09-20", "hari": ["bad"]}]}}}},
    {"name": "simpanRekap setoran bad date", "body": {"action": "simpanRekap", "data": {"hari": {}, "setoran": {"tambah": [{"tgl": "20-09-2026", "hari": ["2026-09-10"]}]}}}},
    {"name": "simpanRekap marks, aktual, mdrManual, unknown group", "body": {"action": "simpanRekap", "data": {"by": "Parity Finance", "hari": {
      "2026-09-10": {"setor": true, "mdr": {"edc_bri": "12.500", "unknownBank": 9}, "aktual": {"qris_bri": "1.000.000", "edc_bca": ""}, "mdrManual": {"gofood": -5, "grabfood": "2500"}, "esb": {"cash": 1, "newGroup": true, "0": true}},
      "2026-09-11": {"aktual": {"edc_bri": null}, "mdrManual": {"gofood": ""}},
      "bad-date": {"setor": true},
      "2026-09-12": "not an object"
    }}}},
    {"name": "simpanRekap deletes one deposit and adds a capped partial one", "ignore": ["data.setoran.*.id", "data.setoran.*.at"], "body": {"action": "simpanRekap", "data": {"by": "Kasir Parity", "hari": {},
      "setoran": {"hapus": ["st1a0add5bb0069c", "nope"], "tambah": [{"tgl": "2026-09-18", "tujuan": " BRI ", "catatan": " sebagian ", "hari": ["2026-09-08", "2026-09-07", "2026-09-07", "junk"], "jumlah": {"2026-09-07": "999.999.999", "2026-09-08": -3}}]}}}},
    {"name": "simpanRekap a deposit for already-covered days is zero", "body": {"action": "simpanRekap", "data": {"hari": {}, "setoran": {"tambah": [{"tgl": "2026-09-18", "hari": ["2026-09-07"]}]}}}},
    {"name": "getAll after the narrow writes", "method": "GET", "query": {"action": "getAll"}, "ignore": ["ts", "data.rekap_setoran.*.id", "data.rekap_setoran.*.at"]},
    {"name": "omsetPic after the writes", "method": "GET", "query": {"action": "omsetPic", "dari": "2026-08-01", "sampai": "2026-09-30"}},

    {"name": "saveAll with baseTs 0 replaces the blob (arrays stay arrays)", "body": {"action": "saveAll", "baseTs": 0, "data": {"_savedBy": "Parity", "daily": [{"date": "2026-10-01", "food": "1.000", "bd": {"marketing": [{"picId": "p1", "amount": 10, "ob": true, "obAmount": "5"}]}}], "settings": {}, "employees": {"marketing": [{"id": "p1", "name": "PIC Satu", "officeUserId": "u-aurel"}]}}}},
    {"name": "getAll after saveAll", "method": "GET", "query": {"action": "getAll"}, "ignore": ["ts"]},
    {"name": "saveAll with an old baseTs after that is refused", "body": {"action": "saveAll", "baseTs": 1790095951190, "data": {"daily": []}}, "ignore": ["ts"]},
    {"name": "omsetPic on the new blob", "method": "GET", "query": {"action": "omsetPic", "dari": "2026-10-01", "sampai": "2026-10-01"}},
    {"name": "simpanTarget on the new blob", "body": {"action": "simpanTarget", "data": {"target": {"p1": "7.000.000", "gone": 1}}}},
    {"name": "stats at the end", "method": "GET", "query": {"action": "stats"}, "ignore": ["data.updated_at"]}
  ]
}
