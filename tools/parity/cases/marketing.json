{
  "dir": "marketing-mysql",
  "legacyPath": "marketing-api-mysql",
  "dbEnv": "MARKETING",
  "db": "lakk5493_db_marketing",
  "ignore": ["data.ts", "data.backend", "data.db", "data.folderBerkas", "data.folderSampah", "data.amanDiLuarWeb", "data.berkasDibuang"],
