    { "name": "unknown action", "body": { "action": "nope" } },
    { "name": "eventsHari event done", "method": "GET", "query": { "action": "eventsHari", "tgl": "2026-09-20" } },
    { "name": "eventsHari deal", "method": "GET", "query": { "action": "eventsHari", "tgl": "2026-10-22" } },
    { "name": "eventsHari VIP day", "method": "GET", "query": { "action": "eventsHari", "tgl": "2026-08-13" } },
