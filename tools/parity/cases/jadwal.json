{
  "dir": "jadwal-mysql",
  "legacyPath": "jadwal-api-mysql",
  "dbEnv": "JADWAL",
  "db": "lakk5493_db_jadwal",
  "sessions": {
    "admin": "SELECT CONCAT(name,'|',pin) FROM users WHERE id='u-admin'",
    "headbar": "SELECT CONCAT(name,'|',pin) FROM users WHERE id='u-arif'",
    "headfloor": "SELECT CONCAT(name,'|',pin) FROM users WHERE id='u-mella'",
    "crewbar": "SELECT CONCAT(name,'|',pin) FROM users WHERE id='u-yuzaalfarel'",
    "hrd": "SELECT CONCAT(name,'|',pin) FROM users WHERE id='u-rizkiarfan'"
  },
  "ignore": [
    "data.ts",
    "data.backend",
    "data.db",
    "data.pengajuan.*.dibuatAt",
    "data.pengajuan.*.putusAt",
    "data.pengajuan.*.headAt"
  ],
  "cases": [
    {
      "name": "ping",
      "method": "GET",
      "query": {
        "action": "ping"
      }
    },
    {
      "name": "stats",
      "method": "GET",
      "query": {
        "action": "stats"
      }
    },
    {
      "name": "headIds (open)",
      "method": "GET",
      "query": {
        "action": "headIds"
      }
    },
    {
      "name": "shiftHari all (open)",
      "method": "GET",
      "query": {
        "action": "shiftHari",
        "dari": "2026-09-01",
        "sampai": "2026-09-30"
      }
    },
    {
      "name": "shiftHari one user",
      "method": "GET",
      "query": {
        "action": "shiftHari",
        "user": "u-yuzaalfarel",
        "dari": "2026-09-30",
        "sampai": "2026-09-01"
      }
    },
    {
      "name": "shiftHari bad date",
