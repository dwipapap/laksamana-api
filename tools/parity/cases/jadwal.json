    {
      "name": "HRD cannot approve before head",
      "body": {
        "action": "putusPengajuan",
        "sesi": "$sesi:hrd",
        "id": "Aparity1",
        "status": "DISETUJUI"
      }
    },
    {
      "name": "HRD cannot do head step",
      "body": {
        "action": "putusPengajuan",
        "sesi": "$sesi:hrd",
        "id": "Aparity1",
        "status": "MENUNGGU_HRD"
      }
    },
    {
      "name": "floor head cannot decide bar crew",
      "body": {
        "action": "putusPengajuan",
        "sesi": "$sesi:headfloor",
        "id": "Aparity1",
        "status": "MENUNGGU_HRD"
      }
    },
    {
      "name": "bar head forwards to HRD",
      "body": {
        "action": "putusPengajuan",
        "sesi": "$sesi:headbar",
        "id": "Aparity1",
        "status": "MENUNGGU_HRD",
        "nota": "ok head"
      }
    },
    {
      "name": "bar head cannot final-approve",
      "body": {
        "action": "putusPengajuan",
        "sesi": "$sesi:headbar",
        "id": "Aparity1",
        "status": "DISETUJUI"
      }
    },
    {
      "name": "HRD approves",
      "body": {
        "action": "putusPengajuan",
        "sesi": "$sesi:hrd",
        "id": "Aparity1",
        "status": "DISETUJUI",
        "nota": "sah"
      }
    },
    {
      "name": "bad status",
      "body": {
        "action": "putusPengajuan",
        "sesi": "$sesi:hrd",
        "id": "Aparity1",
        "status": "YES"
      }
    },
    {
      "name": "missing request",
      "body": {
        "action": "putusPengajuan",
        "sesi": "$sesi:hrd",
        "id": "Anope",
        "status": "DITOLAK"
      }
