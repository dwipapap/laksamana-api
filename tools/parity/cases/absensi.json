  "sessions": {
    "admin": "SELECT CONCAT(name,'|',pin) FROM users WHERE id='u-admin'",
    "crew": "SELECT CONCAT(name,'|',pin) FROM users WHERE id='u-dwipa'",
    "luar": "SELECT CONCAT(name,'|',pin) FROM users WHERE id='u-yuzaalfarel'"
