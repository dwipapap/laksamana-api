    "data.hariIni.pulang.jam",
    "data.hari.*.masuk.id",
    "data.hari.*.masuk.waktu",
    "data.hari.*.masuk.jam",
    "data.hari.*.pulang.id",
    "data.hari.*.pulang.waktu",
    "data.hari.*.pulang.jam",
