    { "name": "getAll after the new rows", "method": "GET", "query": { "action": "getAll" } },
    { "name": "eventsHari on the parity date (drops Planning, keeps legacy Finished)", "method": "GET", "query": { "action": "eventsHari", "tgl": "2031-03-04" } },
    { "name": "eventsHari next day (UTC evening lands on WIB tomorrow)", "method": "GET", "query": { "action": "eventsHari", "tgl": "2031-03-05" } },
    { "name": "saveAll older stamp does not overwrite", "body": { "action": "saveAll", "data": {
      "talents": [{ "id": "tl_par1", "name": "SHOULD NOT WRITE", "updatedAt": 1790000000000 }]
    } } },
    { "name": "saveAll equal stamp overwrites", "body": { "action": "saveAll", "data": {
      "ideas": [{ "id": "id_par1", "name": "Parity Idea v2", "updatedAt": 1790100000000 }]
    } } },
    { "name": "saveAll bounded delete keeps rows newer than the payload's newest stamp", "body": { "action": "saveAll", "data": {
      "refunds": [{ "id": "rf_par2", "order_id": "or_par1", "status": "New", "updatedAt": 1790099999999 }]
    } } },
    { "name": "saveAll unstamped payload deletes without a bound", "body": { "action": "saveAll", "data": {
      "calendarExtra": [{ "id": "ce_par2", "type": "note", "title": "Only me", "date": "2031-03-06" }]
    } } },
    { "name": "saveAll empty lists delete nothing", "body": { "action": "saveAll", "data": {
      "talents": [], "events": [], "checkins": [], "eventDetails": []
    } } },
    { "name": "saveAll checkin resend is ignored (append-only)", "body": { "action": "saveAll", "data": {
      "checkins": [{ "id": "ci_par1", "ticket_id": "CHANGED", "result": "Invalid" }]
    } } },
    { "name": "saveAll eventDetails map deletes missing entries", "body": { "action": "saveAll", "data": {
      "eventDetails": { "ev_par1": { "rundown": [], "updatedAt": 1790100000500 }, "123": { "numeric": true } }
    } } },
    { "name": "saveAll null settings are skipped", "body": { "action": "saveAll", "data": {
      "role": null, "layoutTemplates": { "a": 1 }
    } } },
    { "name": "saveAll reused QR token lands on the other ticket, then the bounded delete removes it", "body": { "action": "saveAll", "data": {
      "tickets": [{ "id": "tk_par2", "qr_token": "qr_parity_1", "status": "valid", "updatedAt": 1790100000900 }]
    } } },
    { "name": "getAll after writes", "method": "GET", "query": { "action": "getAll" } },
    { "name": "stats after writes", "method": "GET", "query": { "action": "stats" } },

    { "name": "upload empty", "body": { "action": "upload" } },
    { "name": "upload wrong type", "body": { "action": "upload", "dataBase64": "aGVsbG8=", "fileName": "x.exe", "mimeType": "application/x-msdownload" } },
    { "name": "upload bad base64", "body": { "action": "upload", "dataBase64": "@@@", "mimeType": "image/png" } },
    { "name": "upload png", "body": { "action": "upload", "dataBase64": "data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mP8z8BQDwAEhQGAhKmMIQAAAABJRU5ErkJggg==", "mimeType": "image/png", "fileName": "ktp.png" }, "ignore": ["data.key", "data.at"] },
    { "name": "upload pdf by name, no fileName echo", "body": { "action": "upload", "dataBase64": "aGVsbG8=", "mimeType": "", "fileName": "Kontrak.PDF" }, "ignore": ["data.key", "data.at"] },
    { "name": "upload jpeg extension without name", "body": { "action": "upload", "dataBase64": "aGVsbG8=", "mimeType": "image/jpeg" }, "ignore": ["data.key", "data.name", "data.at"] },
    { "name": "file missing", "method": "GET", "query": { "action": "file", "key": "ev_nope.png" } },
    { "name": "file traversal", "method": "GET", "query": { "action": "file", "key": "../config.php" } },
    { "name": "file empty key", "method": "GET", "query": { "action": "file" } }
