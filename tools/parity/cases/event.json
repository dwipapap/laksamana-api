    { "name": "ping", "method": "GET", "query": { "action": "ping" } },
    { "name": "stats", "method": "GET", "query": { "action": "stats" } },
    { "name": "getAll (default GET)", "method": "GET", "query": {} },
    { "name": "getAll", "method": "GET", "query": { "action": "getAll" } },
    { "name": "unknown GET action", "method": "GET", "query": { "action": "nope" } },
    { "name": "empty GET action", "method": "GET", "query": { "action": "" } },
    { "name": "unknown POST action", "body": { "action": "nope" } },
    { "name": "POST without action", "body": { "data": {} } },
    { "name": "eventsHari every event date", "method": "GET", "query": { "action": "eventsHari", "tgl": "$each" },
      "each": "SELECT DISTINCT DATE(start_datetime) FROM events WHERE start_datetime IS NOT NULL ORDER BY 1" },
    { "name": "eventsHari date without events", "method": "GET", "query": { "action": "eventsHari", "tgl": "1999-01-01" } },
    { "name": "eventsHari invalid date", "method": "GET", "query": { "action": "eventsHari", "tgl": "27-09-2026" } },
    { "name": "eventsHari missing date", "method": "GET", "query": { "action": "eventsHari" } },
    { "name": "eventsHari padded date passes the trim check", "method": "GET", "query": { "action": "eventsHari", "tgl": " 2026-09-27 " } },
    { "name": "eventsHari via POST body is not read", "body": { "action": "eventsHari", "tgl": "2026-09-27" } },

    { "name": "saveAll without data", "body": { "action": "saveAll" } },
    { "name": "saveAll data not an object", "body": { "action": "saveAll", "data": "x" } },
    { "name": "saveAll empty object", "body": { "action": "saveAll", "data": {} } },
